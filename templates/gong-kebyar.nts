;; Gong kebyar: selisir scale, the instruments of Gold's figure 2.7
;; (Music in Bali, 2005, p. 40), and the gongs, kempli and kendang.
;; A piece can redefine any of these, e.g. to change an instrument's range,
;; and defines any colotomy not here (01, "colotomy"; ADR 0046).

(use selisir)

;; Stroke sets.  Following Gold's symbols, the gongs are one instrument:
;; G gong wadon, GL gong lanang, P kempur, T klentong.
(strokes kempli-strokes  K)
(strokes gong-strokes  G GL P T)
(strokes kendang-strokes  dag dug du)

;; Pitched instruments, lowest first.  Octave numbers are shared by all
;; instruments: o2 on the ugal and o2 on the jublag are the same pitch.
(instrument jegogan   selisir  i1 o1 e1 u1 a1)
(instrument jublag    selisir  i2 o2 e2 u2 a2)
(instrument calung    selisir  i2 o2 e2 u2 a2)     ; another name for the jublag
(instrument panyacah  selisir  i3 o3 e3 u3 a3)
(instrument ugal      selisir  o1 e1 u1 a1 i2 o2 e2 u2 a2 i3)
(instrument pemade    selisir  o2 e2 u2 a2 i3 o3 e3 u3 a3 i4)    ; gangsa pemade
(instrument kantilan  selisir  o3 e3 u3 a3 i4 o4 e4 u4 a4 i5)    ; gangsa kantilan
(instrument trompong  selisir  a1 i2 o2 e2 u2 a2 i3 o3 e3 u3)
(instrument reyong    selisir  e2 u2 a2 i3 o3 e3 u3 a3 i4 o4 e4 u4)

;; Stroke instruments.  A score shows their names with :note-names.
(instrument kempli  kempli-strokes   K)
(instrument gong    gong-strokes     G GL P T)
(instrument kendang kendang-strokes  dag dug du)

;; Colotomies used in many pieces.  A piece names one with :colotomy.
;; Gilak, 8 pulses: gong lanang on 4, kempur on 5 and 7, gong on 8.
(colotomy gilak 8
  (part :instrument gong  -:3 GL:1 P - P G))

;; Bapang, 16 pulses: kempur on 4 and 12, klentong on 8, gong on 16.
(colotomy bapang 16
  (part :instrument gong  -:3 P:1 -:3 T:1 -:3 P:1 -:3 G:1))
