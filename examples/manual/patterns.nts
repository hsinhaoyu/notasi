(piece "Norot")

(use gong-kebyar)

;; A two-pulse norot figure on the tone i (ding).
(pattern norot :instrument reyong
  o3:1/4 i3 i3 - | i3 - i3 -)

;; The figure on i, moved down a pitch (to a), up a pitch (to o),
;; and on i again: eight pulses.
(part :instrument reyong
  @norot
  (@ norot :step -1)
  (@ norot :step 1)
  @norot)
