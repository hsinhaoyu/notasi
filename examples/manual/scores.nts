(piece "Kotekan")

(use gong-kebyar)

(part :instrument reyong :name polos    i3:1/4 _  i3 o3 | _  i3 o3 _  | o3 i3 _  o3 | i3 o3 _  i3)
(part :instrument reyong :name sangsih  e3:1/4 u3 e3 _  | u3 e3 _  u3 | _  e3 u3 _  | e3 _  u3 e3)
(part :instrument gong                  G:1 -:2 P:1)

;; Polos and sangsih together, the gongs and kempli with their letters,
;; two pulses on each line.
(score full :palette set2 :system-length 2
  (group "Reyong" :subtitle "polos + sangsih"  polos sangsih)
  (group "Gong" :note-names yes  gong kempli))
