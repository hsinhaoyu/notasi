(piece "Gilak" :colotomy gilak :pickup 1)

(use gong-kebyar)

(colotomy gilak 8
  (gong gong  -:3 P:1 -  P  -  G))

(part ugal  a1 || o2 i2 e2 o2 | a1 o2 i2 a1
             || e2 u2 e2 o2 | i2 o2 e2 a1 ||)

;; The whole piece: a new line at each cycle, the long labels on the
;; first line and the short ones after.
(score whole :breaks ((1 1) (2 1))
  (group "Ugal" :short "U." ugal)
  (group "Gong" :short "G." gong))

;; Only the second cycle, counted with the gong on 1.
(score second :from (2 2) :to (2 1) :numbering gong-first :labels short
  (group "Ugal" :short "U." ugal)
  (group "Gong" :short "G." gong))
